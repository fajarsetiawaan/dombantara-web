# ------------------------------------------------------------------------------
# D O M B A N T A R A   -   E N V I R O N M E N T   V A R I A B L E S
# ------------------------------------------------------------------------------
# Copy this file to .env.local and replace the placeholders with your actual keys
# Do NOT commit .env.local to version control.
# ------------------------------------------------------------------------------

# --- INSFORGE BACKEND ---
NEXT_PUBLIC_INSFORGE_URL=https://YOUR_APPKEY.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_anon_key_here

# --- XENDIT PAYMENT GATEWAY ---
# Dapatkan Secret Key dan Public Key dari Dashboard Xendit (Test / Live Mode)
XENDIT_SECRET_KEY=xnd_test_placeholder_secret_key_12345
NEXT_PUBLIC_XENDIT_PUBLIC_KEY=xnd_public_test_placeholder_key_67890
XENDIT_WEBHOOK_TOKEN=placeholder_webhook_token_for_verification

# --- API URL ---
NEXT_PUBLIC_API_URL=https://YOUR_APPKEY.us-east.insforge.app
